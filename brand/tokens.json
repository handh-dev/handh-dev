{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "handh.dev design tokens. Source of truth for color, type, space, radius, motion. Brand name rules live in BRAND.md section 1.",
  "brand": {
    "name": { "$value": "handh.dev", "$description": "Display name. Always lowercase. Never abbreviate. Never use an ampersand." },
    "slug": { "$value": "handh-dev", "$description": "Use where a dot is not allowed: repo names, package names, file names, handles, URL paths." }
  },
  "color": {
    "core": {
      "ink":  { "$value": "#1d252f", "$description": "Logo charcoal. Primary text and dark surfaces." },
      "blue": { "$value": "#0073fe", "$description": "Logo blue. Brand signal: logo, large display text, graphics, focus rings, highlights. 4.30:1 on white, so NOT for small text." },
      "white": { "$value": "#ffffff" }
    },
    "blue": {
      "50":  { "$value": "#eef5ff" },
      "100": { "$value": "#d9e8ff" },
      "200": { "$value": "#b5d3ff" },
      "300": { "$value": "#82b5ff" },
      "400": { "$value": "#4a93ff", "$description": "Links and accents on dark surfaces (6.32:1 on #0b0f14)." },
      "500": { "$value": "#0073fe", "$description": "= core.blue" },
      "600": { "$value": "#005fd6", "$description": "Action color on light surfaces: buttons, links, small blue text (5.82:1 on white)." },
      "700": { "$value": "#004cad", "$description": "Hover/pressed for 600." },
      "800": { "$value": "#003b87" },
      "900": { "$value": "#002a61" },
      "950": { "$value": "#001a3d" }
    },
    "ink": {
      "50":  { "$value": "#f6f7f9", "$description": "Light page background (alt)." },
      "100": { "$value": "#eceef2", "$description": "Subtle fill, code background on light." },
      "200": { "$value": "#d8dce3", "$description": "Borders on light." },
      "300": { "$value": "#b6bdc8" },
      "400": { "$value": "#8a94a3", "$description": "Muted text on dark (5.70:1 on #141a22)." },
      "500": { "$value": "#5f6a7a", "$description": "Muted text on light (5.48:1 on white)." },
      "600": { "$value": "#434d5b" },
      "700": { "$value": "#313a46", "$description": "Borders on dark." },
      "800": { "$value": "#1d252f", "$description": "= core.ink" },
      "900": { "$value": "#141a22", "$description": "Dark surface / card on dark." },
      "950": { "$value": "#0b0f14", "$description": "Dark page background." }
    },
    "status": {
      "success": { "$value": "#0f8a5f" },
      "warning": { "$value": "#b25e00" },
      "danger":  { "$value": "#d1293d" },
      "$description": "Functional only. Never decorative. Never in the logo or brand graphics."
    },
    "semantic": {
      "light": {
        "bg":          { "$value": "#ffffff" },
        "bg-subtle":   { "$value": "#f6f7f9" },
        "surface":     { "$value": "#ffffff" },
        "border":      { "$value": "#d8dce3" },
        "text":        { "$value": "#1d252f" },
        "text-muted":  { "$value": "#5f6a7a" },
        "action":      { "$value": "#005fd6", "$description": "Filled buttons/controls. White label = 5.82:1." },
        "action-hover":{ "$value": "#004cad" },
        "link":        { "$value": "#005fd6" },
        "on-action":   { "$value": "#ffffff" },
        "signal":      { "$value": "#0073fe" },
        "focus":       { "$value": "#0073fe" },
        "code-bg":     { "$value": "#eceef2" }
      },
      "dark": {
        "bg":          { "$value": "#0b0f14" },
        "bg-subtle":   { "$value": "#141a22" },
        "surface":     { "$value": "#141a22" },
        "border":      { "$value": "#313a46" },
        "text":        { "$value": "#f6f7f9" },
        "text-muted":  { "$value": "#8a94a3" },
        "action":      { "$value": "#005fd6", "$description": "Same fill as light mode so white labels stay 5.82:1." },
        "action-hover":{ "$value": "#004cad" },
        "link":        { "$value": "#4a93ff", "$description": "6.32:1 on #0b0f14." },
        "on-action":   { "$value": "#ffffff" },
        "signal":      { "$value": "#4a93ff" },
        "focus":       { "$value": "#4a93ff" },
        "code-bg":     { "$value": "#1d252f" }
      }
    },
    "ratio": {
      "$description": "Color budget for any composition, by visible area.",
      "neutral": { "$value": "75%" },
      "ink":     { "$value": "15%" },
      "blue":    { "$value": "10%" }
    }
  },
  "font": {
    "display": { "$value": "'Lexend', 'Inter', system-ui, sans-serif", "$description": "Headlines. 600 or 700. Closest match to the wordmark's geometric letterforms." },
    "body":    { "$value": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "UI and paragraphs. 400/500/600." },
    "mono":    { "$value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace", "$description": "Code, labels, eyebrows, data." },
    "google-fonts-url": { "$value": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Lexend:wght@500;600;700&display=swap" }
  },
  "type-scale": {
    "$description": "Ratio 1.25 (major third), base 16px. Display sizes use clamp() for fluid layouts.",
    "xs":   { "$value": "12px", "line-height": "16px" },
    "sm":   { "$value": "14px", "line-height": "20px" },
    "base": { "$value": "16px", "line-height": "26px" },
    "lg":   { "$value": "20px", "line-height": "30px" },
    "xl":   { "$value": "25px", "line-height": "32px" },
    "2xl":  { "$value": "31px", "line-height": "38px" },
    "3xl":  { "$value": "39px", "line-height": "44px" },
    "4xl":  { "$value": "49px", "line-height": "54px" },
    "5xl":  { "$value": "61px", "line-height": "64px" },
    "6xl":  { "$value": "76px", "line-height": "78px" },
    "tracking": {
      "display": { "$value": "-0.025em" },
      "body":    { "$value": "0" },
      "eyebrow": { "$value": "0.08em", "$description": "Mono, uppercase, xs or sm." }
    }
  },
  "space": {
    "$description": "4px base grid. Use only these steps.",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "24px" }, "6": { "$value": "32px" }, "7": { "$value": "48px" }, "8": { "$value": "64px" },
    "9": { "$value": "96px" }, "10": { "$value": "128px" }
  },
  "radius": {
    "$description": "From the mark: outer corners round, inner edges square. Asymmetric radius is the signature.",
    "none": { "$value": "0px" },
    "sm":   { "$value": "6px" },
    "md":   { "$value": "10px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "24px" },
    "mark": { "$value": "42%", "$description": "Outer-corner radius as a fraction of a stem/bar width, measured from the brandmark." },
    "pill": { "$value": "999px", "$description": "Tags and badges only." }
  },
  "border": {
    "hairline": { "$value": "1px" },
    "seam":     { "$value": "2.5%", "$description": "The gap between the two halves of the mark, as a fraction of mark width. Use as a gap, not a line." }
  },
  "shadow": {
    "$description": "Shadows are rare. Prefer borders and surface contrast.",
    "sm": { "$value": "0 1px 2px rgba(11,15,20,0.06), 0 1px 1px rgba(11,15,20,0.04)" },
    "md": { "$value": "0 8px 24px -8px rgba(11,15,20,0.18)" },
    "focus": { "$value": "0 0 0 3px rgba(0,115,254,0.35)" }
  },
  "angle": {
    "cut": { "$value": "64deg", "$description": "Angle of the diagonal cut in the mark, from horizontal. The only diagonal used in brand graphics." }
  },
  "motion": {
    "ease-out":    { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "ease-in-out": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)" },
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "360ms" },
    "$description": "Short, decisive, no bounce. Respect prefers-reduced-motion."
  },
  "layout": {
    "max-width":       { "$value": "1200px" },
    "max-width-prose": { "$value": "68ch" },
    "gutter-mobile":   { "$value": "16px" },
    "gutter-desktop":  { "$value": "32px" },
    "columns":         { "$value": "12" }
  }
}
